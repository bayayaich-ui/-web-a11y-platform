{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/sites/layout,_N_T_/sites/new/layout,_N_T_/sites/new/page,_N_T_/sites/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/sites/new/__PAGE__",
    "/sites/new",
    "/sites",
    "/_index",
    "/_head"
  ]
}